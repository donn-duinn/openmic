{
  "name": "openmic",
  "version": "0.1.0",
  "private": true,
  "description": "Free open mic sign-up system for Melbourne venues",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute openmic --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute openmic --remote --file=./schema.sql"
  },
  "dependencies": {
    "qrcode-svg": "^1.1.0"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
  }
}
